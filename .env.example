# Copy to .env and fill in real values. .env is git-ignored.

# PostgreSQL (docker-compose service `db`)
POSTGRES_USER=mziko
POSTGRES_PASSWORD=mziko
POSTGRES_DB=mziko
# Host port. Pick another one (e.g. 5433) if a local Postgres already uses 5432.
POSTGRES_PORT=5432

# Used when running the backend locally with uv; inside docker-compose it is overridden.
# Keep the port in sync with POSTGRES_PORT.
DATABASE_URL=postgresql+asyncpg://mziko:mziko@localhost:5432/mziko

# Public address of the app, used in pairing links sent by the bot.
PUBLIC_URL=http://localhost
# Caddy site address: ":80" locally, your domain in production (enables HTTPS).
SITE_ADDRESS=:80
# Host ports for the web container; change if 80/443 are taken on this machine.
HTTP_PORT=80
HTTPS_PORT=443

# Telegram bot
BOT_TOKEN=
# Comma-separated Telegram user ids allowed to manage children.
ADMIN_TELEGRAM_IDS=[]
# Shared secret between the bot and /api/parent/*; generate with `openssl rand -hex 32`.
BOT_API_TOKEN=
# Where the bot finds the API when run locally with uv; inside docker-compose it is overridden.
API_URL=http://localhost:8000

# Back office (docker-compose service `admin`, served at PUBLIC_URL/admin/)
# Shared secret between the back office and /api/admin/*; generate with `openssl rand -hex 32`.
ADMIN_API_TOKEN=
# The only Google account allowed in.
ADMIN_EMAIL=
# OAuth client from Google Cloud Console; authorised redirect URI: PUBLIC_URL/admin/login/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the back office session cookie; generate with `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=
