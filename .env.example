# Copy to .env and fill in real values. .env is git-ignored.

# PostgreSQL (docker-compose service `db`)
POSTGRES_USER=mziko
POSTGRES_PASSWORD=mziko
POSTGRES_DB=mziko
# Host port. Pick another one (e.g. 5433) if a local Postgres already uses 5432.
POSTGRES_PORT=5432

# Used when running the backend locally with uv; inside docker-compose it is overridden.
# Keep the port in sync with POSTGRES_PORT.
DATABASE_URL=postgresql+asyncpg://mziko:mziko@localhost:5432/mziko

# Public address of the app, used in pairing links sent by the bot.
PUBLIC_URL=http://localhost
# Caddy site address: ":80" locally, your domain in production (enables HTTPS).
SITE_ADDRESS=:80

# Telegram bot
BOT_TOKEN=
# Comma-separated Telegram user ids allowed to manage children.
ADMIN_TELEGRAM_IDS=[]
