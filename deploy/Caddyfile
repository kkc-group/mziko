# SITE_ADDRESS is ":80" for local runs and "mziko.example.com" in production,
# where Caddy obtains a Let's Encrypt certificate automatically.
{$SITE_ADDRESS}

encode gzip

handle /api/* {
	reverse_proxy api:8000
}

# The back office keeps the /admin prefix itself, so nothing is stripped here.
handle /admin/* {
	reverse_proxy admin:8080
}

# The parents' cabinet (Telegram Mini App) lives in the same process as the back office.
redir /cabinet /cabinet/ permanent
handle /cabinet/* {
	reverse_proxy admin:8080
}

handle_path /media/* {
	root * /srv/media
	file_server
}

# The parents' landing page, built from docs/general/parent-guide.md into the image.
redir /about /about/ permanent
handle_path /about/* {
	root * /srv/about
	header Cache-Control "no-cache"
	file_server
}

handle {
	root * /srv/web
	try_files {path} /index.html
	# Hashed assets never change; the shell, the manifest and the service worker
	# must be re-checked every time, or a browser keeps an old build for days.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@shell not path /assets/*
	header @shell Cache-Control "no-cache"
	file_server
}
